{
  "name": "aegisdesk-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:migrations": "vitest run --config vitest.migrations.config.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "npm run typecheck && npm test -- --run && npm run test:migrations && npm run lint && npm run check",
    "deploy": "npm run verify && wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@types/node": "^24.5.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aegisdesk-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "https://tonymlzero.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "b0c8d2d72724e0694257e42bce64544cfa8f80ad8e9c74587c82b81324d3b3b6",
    "STATE_ISSUER": "https://aegisdesk.tonyml.com",
    "STATE_KEY_ID": "ed25519-2026-01",
    "CONTACT_NAME": "Soporte Aegis",
    "TICKET_URL": "https://aegisdesk.tonyml.com/tickets",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFHgQ5CkC8xaE4Xk",
    "NOTIFY_FROM": "aegisdesk@tonyml.com",
    "NOTIFY_DESTINATION": "soporte@tonyml.com",
    "REQUIRED_TERMS_VERSION": "0.1.0",
    "TERMS_URL": "https://aegisdesk.tonyml.com/legal/terms",
    "PRIVACY_URL": "https://aegisdesk.tonyml.com/legal/privacy",
    "PLATFORM_OWNER_EMAILS": "antony.mongelopez@ucr.ac.cr,soporte@tonyml.com,soporte@femucaribe.go.cr",
    "CACHE_MAX_AGE_SECONDS": 259200,
    "OFFLINE_GRACE_SECONDS": 1209600
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aegisdesk",
      "database_id": "70e707bc-09d0-4dfe-b79e-4b1b1e15e630",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "routes": [
    {
      "pattern": "aegisdesk.tonyml.com",
      "custom_domain": true
    }
  ]
}
